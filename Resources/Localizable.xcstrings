      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary files left behind by apps"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 쓰다 남긴 임시 파일"
          }
        }
      }
    },
    "앱이에요. 지우면 앱이 사라지고, 설정은 ~/Library 폴더에 남아요.": {
