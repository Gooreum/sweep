{
  "sourceLanguage": "ko",
  "strings": {
    "%@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "%@ %lld개": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %#@items@"
          },
          "substitutions": {
            "items": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg item"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg items"
                    }
                  }
                }
              }
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld개"
          }
        }
      }
    },
    "%@ 검색 중…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning %@…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 검색 중…"
          }
        }
      }
    },
    "%@ 만듦": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Created %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 만듦"
          }
        }
      }
    },
    "%@ 안에 표시할 항목이 없어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No items to show in %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 안에 표시할 항목이 없어요"
          }
        }
      }
    },
    "%@ 외 %lld개": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ and %lld more"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 외 %2$lld개"
          }
        }
      }
    },
    "%@ 외 %lld곳에서 큰 파일과 중복 파일을 찾아요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find large and duplicate files in %1$@ and %2$lld more locations"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 외 %2$lld곳에서 큰 파일과 중복 파일을 찾아요"
          }
        }
      }
    },
    "%@ 폴더에서 %@을 찾아볼게요. 이 폴더를 선택하고 허용을 눌러 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look for %2$@ in the %1$@ folder. Select this folder and click Allow."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 폴더에서 %2$@을 찾아볼게요. 이 폴더를 선택하고 허용을 눌러 주세요."
          }
        }
      }
    },
    "%@, 총 %lld개는 관리자 소유라 남겨 뒀어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left %1$@, %2$lld items in total, because they belong to an administrator"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, 총 %2$lld개는 관리자 소유라 남겨 뒀어요"
          }
        }
      }
    },
    "%@개 확인 중…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking %@ items…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@개 확인 중…"
          }
        }
      }
    },
    "%@개 확인했어요…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checked %@ items…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@개 확인했어요…"
          }
        }
      }
    },
    "%@에 %@이 설치되어 있어요. 지우면 안에 설치한 앱과 설정도 없어져요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ has %2$@ installed. Deleting it also removes the apps and settings inside"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에 %2$@이 설치되어 있어요. 지우면 안에 설치한 앱과 설정도 없어져요"
          }
        }
      }
    },
    "%@에서 버린 파일이에요. 완전히 지우면 복구할 수 없어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files discarded from %@. Permanently deleting them cannot be undone"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 버린 파일이에요. 완전히 지우면 복구할 수 없어요"
          }
        }
      }
    },
    "%@에서 큰 파일과 중복 파일을 찾아요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find large and duplicate files in %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 큰 파일과 중복 파일을 찾아요"
          }
        }
      }
    },
