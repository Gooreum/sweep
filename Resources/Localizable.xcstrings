            "value": "개발에 쓰려고 Xcode에서 받은 파일이에요"
          }
        }
      }
    },
    "개발용 파일": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Development Files"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발용 파일"
          }
        }
      }
    },
    "개발용 파일과 앱이나 브라우저의 임시 파일, 사용 기록을 찾아요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find development files, app and browser temporary files, and activity logs"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발용 파일과 앱이나 브라우저의 임시 파일, 사용 기록을 찾아요"
          }
        }
      }
    },
    "개발용 파일과 임시 파일부터 큰 파일과 중복 파일까지 찾아드려요. 결과를 보고 필요한 것만 골라 정리하세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find development files, temporary files, large files, and duplicates. Review the results and choose what to clean."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발용 파일과 임시 파일부터 큰 파일과 중복 파일까지 찾아드려요. 결과를 보고 필요한 것만 골라 정리하세요."
          }
        }
      }
    },
    "개인 파일을 휴지통으로 옮겨요. 나중에 휴지통까지 비우면 복구할 수 없어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves your files to Trash. Emptying Trash later permanently deletes them."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 파일을 휴지통으로 옮겨요. 나중에 휴지통까지 비우면 복구할 수 없어요."
          }
        }
      }
    },
    "검색": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색"
          }
        }
      }
    },
    "검색 중": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색 중"
          }
        }
      }
    },
    "검색 중…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색 중…"
          }
        }
      }
    },
    "검색을 눌러 정리할 파일을 찾아보세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click Search to find files to clean"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색을 눌러 정리할 파일을 찾아보세요"
          }
        }
      }
    },
    "검색을 멈췄어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan stopped"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색을 멈췄어요"
          }
        }
      }
    },
    "고른 용량: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected size: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고른 용량: %@"
          }
        }
      }
    },
    "고른 파일은 휴지통에 보관해요. 비우기 전에는 모두 복구할 수 있어요. 이 중 %lld개는 새로 만들 수 없는 파일이에요. 비운 뒤 필요해지면 처음부터 다시 받아야 해요. 빈 공간은 휴지통을 비워야 생겨요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected files stay in Trash. You can restore them all until you empty it. %lld of these files cannot be recreated. If you need them after emptying Trash, you must download them again. Space is freed only when you empty Trash."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고른 파일은 휴지통에 보관해요. 비우기 전에는 모두 복구할 수 있어요. 이 중 %lld개는 새로 만들 수 없는 파일이에요. 비운 뒤 필요해지면 처음부터 다시 받아야 해요. 빈 공간은 휴지통을 비워야 생겨요."
          }
        }
      }
    },
    "고른 항목 %lld개, 찾은 항목 %lld개": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld items selected, %2$lld items found"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고른 항목 %1$lld개, 찾은 항목 %2$lld개"
          }
        }
      }
    },
    "공간 보기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Space View"
          }
        },
        "ko": {
