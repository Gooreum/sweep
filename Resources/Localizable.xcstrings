          }
        }
      }
    },
    "지워도 대부분 개발할 때 다시 생기는 파일이에요. 심사에 낸 앱은 복구할 수 없어 고르지 못하게 했어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most files come back during development. Apps submitted for review cannot be restored, so they cannot be selected."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지워도 대부분 개발할 때 다시 생기는 파일이에요. 심사에 낸 앱은 복구할 수 없어 고르지 못하게 했어요."
          }
        }
      }
    },
    "지워도 됨": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletable"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지워도 됨"
          }
        }
      }
    },
    "지워도 앱에서 다시 만들 수 있는 파일을 찾아요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find files that apps can recreate after deletion"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지워도 앱에서 다시 만들 수 있는 파일을 찾아요"
          }
        }
      }
    },
    "지워도 필요한 임시 파일은 앱에서 새로 만들어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps recreate any temporary files they need after deletion."
