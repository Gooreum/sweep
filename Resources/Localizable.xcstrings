          }
        }
      }
    },
    "앱": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱"
          }
        }
      }
    },
    "앱 사용 기록": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App Activity Logs"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 사용 기록"
          }
        }
      }
    },
    "앱 임시 파일": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App Temporary Files"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 임시 파일"
          }
        }
      }
    },
    "앱 임시 폴더": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App temporary folder"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 임시 폴더"
          }
        }
      }
    },
    "앱을 쓰고 남은 임시 파일": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary files left by apps"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 쓰고 남은 임시 파일"
          }
        }
      }
    },
    "앱을 쓰면서 쌓인 기록이에요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activity logs saved while using apps"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 쓰면서 쌓인 기록이에요"
          }
        }
      }
    },
    "앱을 쓰면서 쌓인 기록이에요. 지운 뒤에도 새 기록이 쌓여요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activity logs saved while using apps. New logs will build up after deletion."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 쓰면서 쌓인 기록이에요. 지운 뒤에도 새 기록이 쌓여요."
          }
        }
      }
    },
    "앱의 임시 파일도 찾으려면 설정에서 Sweep을 켜 주세요. 이후에는 다른 앱의 데이터를 열 때마다 허락을 묻지 않아요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Sweep in Settings to also find app temporary files. You will no longer be asked each time Sweep opens other apps' data."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱의 임시 파일도 찾으려면 설정에서 Sweep을 켜 주세요. 이후에는 다른 앱의 데이터를 열 때마다 허락을 묻지 않아요."
          }
        }
      }
    },
    "앱이 만든 임시 파일과 개발용 파일, 기기 백업을 모아 보여줘요. 필요 없는 것을 골라 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse app temporary files, development files, and device backups. Choose what you no longer need."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 만든 임시 파일과 개발용 파일, 기기 백업을 모아 보여줘요. 필요 없는 것을 골라 주세요."
          }
        }
      }
    },
    "앱이 보관하는 파일이에요. 삭제하면 설정이나 로그인 정보, 문서까지 잃을 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files stored by an app. Deleting them may remove settings, login details, or documents."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 보관하는 파일이에요. 삭제하면 설정이나 로그인 정보, 문서까지 잃을 수 있어요."
          }
        }
      }
    },
    "어느 폴더를 볼까요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which folder would you like to view?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 폴더를 볼까요?"
          }
        }
      }
    },
    "어디에 공간을 쓰는지 확인 중…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking what uses space…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디에 공간을 쓰는지 확인 중…"
          }
        }
      }
    },
    "어디에서 더 찾아볼까요? 큰 파일과 중복 파일이 있을 만한 폴더를 선택해 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where else should we search? Choose folders that may have large or duplicate files."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디에서 더 찾아볼까요? 큰 파일과 중복 파일이 있을 만한 폴더를 선택해 주세요."
          }
        }
      }
    },
    "어디에서 찾을까요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where should we search?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디에서 찾을까요?"
          }
        }
      }
    },
    "어떤 프로그램이 컴퓨터를 바쁘게 하는지 살펴보세요. CPU 정보는 총 %lld개, 성능 %lld개, 효율 %lld개예요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See which programs are keeping your computer busy. CPU: %1$lld cores total, %2$lld performance, %3$lld efficiency."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 프로그램이 컴퓨터를 바쁘게 하는지 살펴보세요. CPU 정보는 총 %1$lld개, 성능 %2$lld개, 효율 %3$lld개예요."
          }
        }
      }
    },
    "어떤 프로그램이 컴퓨터를 바쁘게 하는지 살펴보세요. CPU 정보는 총 %lld개예요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See which programs are keeping your computer busy. CPU: %lld cores total."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 프로그램이 컴퓨터를 바쁘게 하는지 살펴보세요. CPU 정보는 총 %lld개예요."
          }
        }
      }
    },
    "여기서 고르면 휴지통에서도 완전히 없어져요. 다시 되살릴 수 없으니 꼭 확인하세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items selected here are permanently deleted from Trash. Check carefully: they cannot be restored."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 고르면 휴지통에서도 완전히 없어져요. 다시 되살릴 수 없으니 꼭 확인하세요."
          }
        }
      }
    },
