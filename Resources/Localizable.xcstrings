    },
    "허용됨": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용됨"
          }
        }
      }
    },
    "화면 아래 휴지통을 직접 열어 주세요. 비우면 되돌릴 수 없으니 안에 있는 파일을 먼저 확인해 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Trash at the bottom of your screen. Check the files before emptying it: this cannot be undone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 아래 휴지통을 직접 열어 주세요. 비우면 되돌릴 수 없으니 안에 있는 파일을 먼저 확인해 주세요."
          }
        }
      }
    },
    "화면 아래 휴지통을 직접 열어 주세요. 파일을 고르고 ‘되돌려 놓기’를 누르면 원래 자리로 돌아가요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Trash at the bottom of your screen. Select files and click Put Back to restore them to their original locations."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 아래 휴지통을 직접 열어 주세요. 파일을 고르고 ‘되돌려 놓기’를 누르면 원래 자리로 돌아가요."
          }
        }
      }
    },
    "확인": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인"
          }
        }
      }
    },
    "확인 완료": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check Complete"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인 완료"
          }
        }
      }
    },
    "확인 필요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs review"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인 필요"
          }
        }
      }
    },
    "활성 상태 보기 열기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Activity Monitor"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 상태 보기 열기"
          }
        }
      }
    },
    "휴지통": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trash"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통"
          }
        }
      }
    },
    "휴지통 안의 파일을 완전히 지워요. 복구할 수 없어요. 지운 용량만큼 바로 쓸 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deletes files in Trash. They cannot be restored. The space is available right away."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통 안의 파일을 완전히 지워요. 복구할 수 없어요. 지운 용량만큼 바로 쓸 수 있어요."
          }
        }
      }
    },
    "휴지통 열기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Trash"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통 열기"
          }
        }
      }
    },
    "휴지통 이동 실패": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could Not Move to Trash"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통 이동 실패"
          }
        }
      }
    },
    "휴지통에서 완전히 지우고 있어요…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deleting from Trash…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통에서 완전히 지우고 있어요…"
          }
        }
      }
    },
    "휴지통에서 완전히 지워요. 복구할 수 없어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deletes files from Trash. They cannot be restored."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통에서 완전히 지워요. 복구할 수 없어요."
          }
        }
      }
    },
    "휴지통에서 지울 것을 골라 주세요. 큰 항목부터 보여줘요. 지운 항목은 되살릴 수 없어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose files to delete from Trash, largest first. Deleted files cannot be restored."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통에서 지울 것을 골라 주세요. 큰 항목부터 보여줘요. 지운 항목은 되살릴 수 없어요."
          }
        }
      }
    },
    "휴지통으로 보낸 파일은 모두 %@예요. 최근 정리한 때는 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ moved to Trash in total. Last cleanup: %2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통으로 보낸 파일은 모두 %1$@예요. 최근 정리한 때는 %2$@"
          }
        }
      }
    },
    "휴지통으로 옮기기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move to Trash"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통으로 옮기기"
