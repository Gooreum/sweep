          }
        }
      }
    },
    "휴지통 이동 실패": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could Not Move to Trash"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통 이동 실패"
          }
        }
      }
    },
    "휴지통과 다른 앱이 저장한 파일도 찾을 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find files in the Trash and files saved by other apps."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통과 다른 앱이 저장한 파일도 찾을 수 있어요."
          }
        }
      }
    },
    "휴지통과 앱이 저장한 파일도 찾아보세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find files in Trash and files saved by apps"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통과 앱이 저장한 파일도 찾아보세요"
          }
        }
      }
    },
    "휴지통에서 완전히 지우고 있어요…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deleting from Trash…"
          }
        },
        "ko": {
