    "%@ 인터넷 없이 쓰는 파일이에요. 다시 내려받아요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ files for use without internet. They'll be downloaded again"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 인터넷 없이 쓰는 파일이에요. 다시 내려받아요"
          }
        }
      }
    },
    "%@ 폴더를 골라 주세요. (고른 곳: %@)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please choose the %1$@ folder. (You chose: %2$@)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 폴더를 골라 주세요. (고른 곳: %2$@)"
          }
        }
      }
    },
    "%@ 휴지통이에요. 비우면 되돌릴 수 없어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Trash. Emptying it can't be undone"
