    },
    "심사에 낸 앱을 보관한 파일이에요. 삭제하면 되살릴 수 없어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An archive of an app submitted for review. Deleting it cannot be undone"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "심사에 낸 앱을 보관한 파일이에요. 삭제하면 되살릴 수 없어요"
          }
        }
      }
    },
    "쓰고 있는 앱을 먼저 닫고 다시 해 보세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the app using these files, then try again"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰고 있는 앱을 먼저 닫고 다시 해 보세요"
          }
        }
      }
    },
    "아래 항목은 처리되지 않았어요. 항목마다 안내한 조치를 마친 뒤 이것들만 다시 시도해 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The items below were not processed. Follow each item's instructions, then retry just these items."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 항목은 처리되지 않았어요. 항목마다 안내한 조치를 마친 뒤 이것들만 다시 시도해 주세요."
          }
        }
      }
    },
    "아래는 여분의 파일이에요. 지우더라도 내용이 똑같은 원본 하나는 반드시 남아요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are extra copies. Deleting them always leaves one identical original."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래는 여분의 파일이에요. 지우더라도 내용이 똑같은 원본 하나는 반드시 남아요."
          }
        }
      }
    },
    "아래에 있는 곳만 찾아봐요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only these locations are searched"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래에 있는 곳만 찾아봐요"
          }
        }
      }
    },
    "아직 공간이 늘어난 것은 아니에요. 휴지통까지 비워야 %@를 쓸 수 있어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Space has not been freed yet. Empty Trash to use %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 공간이 늘어난 것은 아니에요. 휴지통까지 비워야 %@를 쓸 수 있어요"
          }
        }
      }
    },
    "아직 열어 보지 못한 폴더가 있어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some folders could not be opened yet"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 열어 보지 못한 폴더가 있어요"
          }
        }
      }
    },
    "아직 켜져 있는 앱이에요. 먼저 닫고 다시 해 보세요: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is still running. Close it and try again: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 켜져 있는 앱이에요. 먼저 닫고 다시 해 보세요: %@"
          }
        }
      }
    },
    "안 쓰는 앱을 골라 정리해요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose unused apps to remove"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안 쓰는 앱을 골라 정리해요"
          }
        }
      }
    },
    "안전": {
      "localizations": {
        "en": {
