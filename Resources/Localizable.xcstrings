    "%lld일째 바뀌지 않은 앱 파일이에요. 내용을 먼저 살펴봐요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App cache files unchanged for %lld days. Check their contents before deleting."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld일째 바뀌지 않은 앱 파일이에요. 내용을 먼저 살펴봐요"
          }
        }
      }
    },
    "%lld초": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%llds"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld초"
          }
        }
      }
    },
    ".dmg 파일 등을 열었을 때, 그 안의 파일을 읽고 쓰는 일을 맡아요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handles reading and writing files inside opened disk images, such as .dmg files."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ".dmg 파일 등을 열었을 때, 그 안의 파일을 읽고 쓰는 일을 맡아요."
          }
        }
      }
    },
    "1분에 %@씩 늘어요. 쓰는 앱을 먼저 닫아 주세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Growing by %@ per minute. Close the app using these files before deleting."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1분에 %@씩 늘어요. 쓰는 앱을 먼저 닫아 주세요"
          }
        }
      }
    },
    "AirDrop으로 파일을 보내거나 가까운 Apple 기기와 작업을 이어 주는 일을 해요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helps send files with AirDrop and continue tasks on nearby Apple devices."
          }
