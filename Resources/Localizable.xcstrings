          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용률 ▼"
          }
        }
      }
    },
    "사진 앱에서 사람별로 사진을 모으고, 사물이나 장면으로 찾을 수 있게 해 줘요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helps Photos group people and find pictures by object or scene."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 앱에서 사람별로 사진을 모으고, 사물이나 장면으로 찾을 수 있게 해 줘요."
          }
        }
      }
    },
    "사진, 영상, 백업은 나중에도 필요한지 확인해 주세요. 앱 설치 파일은 다시 받을 곳이 있는지 보고 골라 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check whether you will still need photos, videos, and backups. Before choosing an app installer, make sure you can download it again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진, 영상, 백업은 나중에도 필요한지 확인해 주세요. 앱 설치 파일은 다시 받을 곳이 있는지 보고 골라 주세요."
          }
        }
      }
    },
    "사진과 동영상 속 내용을 알아보는 일을 맡아요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Examines the content of photos and videos."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진과 동영상 속 내용을 알아보는 일을 맡아요."
          }
        }
      }
    },
    "새 사진이 많으면 한 장씩 살펴보는 데 오래 걸려요. 사진을 모두 살펴본 뒤에는 이 작업이 줄어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A large batch of new photos takes time to examine. This work eases once those photos have been processed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 사진이 많으면 한 장씩 살펴보는 데 오래 걸려요. 사진을 모두 살펴본 뒤에는 이 작업이 줄어요."
          }
        }
      }
    },
    "새로 받은 앱을 처음 열 때 검사가 걸려요. 검사가 끝날 때까지 기다리면 돼요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening a newly downloaded app can trigger a check. Give it time to finish."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로 받은 앱을 처음 열 때 검사가 걸려요. 검사가 끝날 때까지 기다리면 돼요."
          }
        }
      }
    },
    "새로 읽기를 멈췄어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh stopped"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再読み込みを停止しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로 읽기를 멈췄어요"
          }
        }
      }
    },
    "새로 읽는 중 %lld%%": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refreshing %lld%%"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再読み込み中 %lld%%"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로 읽는 중 %lld%%"
          }
        }
      }
    },
    "새로 읽는 중 · %@ 읽음": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refreshing · %@ read"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再読み込み中 · %@読み込み済み"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로 읽는 중 · %@ 읽음"
          }
        }
      }
    },
    "새로 추가한 사진과 영상을 살펴보는 동안 CPU를 써요. 분량이 많으면 처리가 끝날 때까지 기다려 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It uses CPU while examining newly added photos and videos. A large collection can take time to finish."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로 추가한 사진과 영상을 살펴보는 동안 CPU를 써요. 분량이 많으면 처리가 끝날 때까지 기다려 주세요."
          }
        }
      }
    },
    "선택 안 됨": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not selected"
          }
        },
        "ko": {
