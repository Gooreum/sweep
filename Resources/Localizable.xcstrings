        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 디스크 접근이 꺼져 있어요. 시스템 설정에서 Sweep을 켜면 휴지통을 열 수 있어요. %@"
          }
        }
      }
    },
