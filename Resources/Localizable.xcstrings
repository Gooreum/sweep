          }
        }
      }
    },
    "기능": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Features"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기능"
          }
        }
      }
    },
    "날짜": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Date"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜"
          }
        }
      }
    },
    "남은 공간은 %@이에요. 전체는 %@이에요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ free out of %2$@ total."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남은 공간은 %1$@이에요. 전체는 %2$@이에요."
          }
        }
      }
    },
    "내 계정에 필요한 파일이나 기본 폴더는 삭제하지 않아요: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files needed for your account and default folders are protected: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 계정에 필요한 파일이나 기본 폴더는 삭제하지 않아요: %@"
          }
        }
      }
    },
    "내 소유가 아닌 항목은 지울 수 없어요: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You cannot delete items you do not own: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 소유가 아닌 항목은 지울 수 없어요: %@"
          }
        }
      }
    },
    "내 폴더": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 폴더"
          }
        }
      }
    },
    "내 폴더 바깥에 보관된 내 파일이에요. 삭제하기 전에 어느 프로그램에 필요한지 확인하세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your files stored outside your home folder. Check which program needs them before deleting."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 폴더 바깥에 보관된 내 파일이에요. 삭제하기 전에 어느 프로그램에 필요한지 확인하세요."
          }
        }
      }
    },
    "내 폴더 안": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inside Home"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 폴더 안"
          }
        }
      }
    },
    "내 폴더 안은 이미 모두 찾고 있어요. 내 폴더 전체나 그 상위 폴더는 추가할 수 없어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your home folder is already fully searched. You cannot add it or a folder that contains it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 폴더 안은 이미 모두 찾고 있어요. 내 폴더 전체나 그 상위 폴더는 추가할 수 없어요."
          }
        }
      }
    },
    "내 폴더에 큰 파일이 있는지 살펴보세요. 직접 추가한 폴더도 함께 찾아요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look for large files in your home folder and folders you added."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 폴더에 큰 파일이 있는지 살펴보세요. 직접 추가한 폴더도 함께 찾아요."
          }
        }
      }
    },
    "내림차순": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Descending"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내림차순"
          }
        }
      }
    },
    "내용을 확인한 뒤 옮길까요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review the contents before moving to Trash?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내용을 확인한 뒤 옮길까요?"
          }
        }
      }
    },
    "다른 곳도 보려면 디스크를 허용해 주세요. 내 폴더와 Mac 전체를 살펴볼 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow disk access to explore more locations, including your home folder and your whole Mac."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 곳도 보려면 디스크를 허용해 주세요. 내 폴더와 Mac 전체를 살펴볼 수 있어요."
          }
        }
      }
    },
    "다른 곳을 보려면 먼저 중단을 눌러 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click Stop before choosing another location."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 곳을 보려면 먼저 중단을 눌러 주세요."
          }
        }
      }
    },
    "다시 검색": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan Again"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 검색"
          }
        }
      }
    },
    "다시 구할 수 있는 파일인지 확인하세요. 다시 받을 수 있다면 정리해도 괜찮아요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check whether you can get these files again. If you can download them again, they are OK to clean up."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 구할 수 있는 파일인지 확인하세요. 다시 받을 수 있다면 정리해도 괜찮아요."
          }
        }
      }
    },
    "다시 만들 수 없음": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't be recreated"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 만들 수 없음"
          }
        }
      }
    },
    "다시 만들 수 있는 파일이 %@ 있어요. %lld일 만에 다시 정리해 볼까요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ of files can be recreated. It has been %2$lld days. Clean up again?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 만들 수 있는 파일이 %1$@ 있어요. %2$lld일 만에 다시 정리해 볼까요?"
          }
        }
      }
    },
    "다시 생김": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comes Back"
          }
        },
        "ko": {
