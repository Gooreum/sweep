            "value": "Delete Permanently"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완전 삭제"
          }
        }
      }
    },
    "완전히 삭제해요. 복구는 불가능해요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deletes files. They cannot be restored"
          }
        },
        "ko": {
