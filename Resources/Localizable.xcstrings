            "state": "translated",
            "value": "Add Folder"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더 추가"
          }
        }
      }
    },
    "폴더를 허용하면 여기서도 찾을 수 있어요": {
      "localizations": {
