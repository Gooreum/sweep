        }
      }
    },
    "폴더를 허용해야 내용을 확인할 수 있어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow folder access to view its contents"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더를 허용해야 내용을 확인할 수 있어요"
