            "value": "활성 상태 보기 열기"
          }
        }
      }
    },
    "휴지통": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trash"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통"
          }
        }
      }
    },
    "휴지통 열기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Trash"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통 열기"
          }
        }
      }
    },
    "휴지통에 남아 있어요. Finder의 휴지통에서 직접 ‘되돌려 놓기’를 할 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still in Trash. You can choose “Put Back” in Finder's Trash."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통에 남아 있어요. Finder의 휴지통에서 직접 ‘되돌려 놓기’를 할 수 있어요."
          }
        }
      }
    },
    "휴지통에 든 것을 크기순으로 보고 골라서 비워요. 비우면 되돌릴 수 없어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See items in Trash by size and choose which to delete. Emptying Trash can't be undone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통에 든 것을 크기순으로 보고 골라서 비워요. 비우면 되돌릴 수 없어요."
          }
        }
      }
    },
    "휴지통에서 바로 지워져 되돌릴 수 없어요. 지운 만큼 공간이 바로 늘어나요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items are deleted from Trash immediately and can't be recovered. The space is freed up right away."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통에서 바로 지워져 되돌릴 수 없어요. 지운 만큼 공간이 바로 늘어나요."
          }
        }
      }
    },
    "휴지통에서 찾을 수 없어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't find this in Trash"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통에서 찾을 수 없어요"
          }
        }
      }
    },
    "휴지통으로 옮기기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move to Trash"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통으로 옮기기"
          }
        }
      }
    },
    "휴지통으로 옮기는 중…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moving to Trash…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통으로 옮기는 중…"
          }
        }
      }
    },
    "휴지통으로 옮길까요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move to Trash?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통으로 옮길까요?"
          }
        }
      }
    },
    "휴지통을 비우기 전까지 되돌릴 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can put items back until you empty Trash."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통을 비우기 전까지 되돌릴 수 있어요."
          }
        }
      }
    },
    "휴지통을 비우기 전까지 되돌릴 수 있어요. 휴지통을 비워야 공간이 늘어나요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can put items back until you empty Trash. Empty Trash to free up space."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통을 비우기 전까지 되돌릴 수 있어요. 휴지통을 비워야 공간이 늘어나요."
          }
        }
      }
    },
    "휴지통을 비우면 %@가 실제로 확보돼요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty Trash to free up %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통을 비우면 %@가 실제로 확보돼요"
          }
        }
      }
    },
    "휴지통을 비워야 디스크 공간이 늘어나요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty Trash to free up disk space"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통을 비워야 디스크 공간이 늘어나요"
          }
        }
      }
    },
    "휴지통을 비웠거나 이미 옮겨져 되돌릴 수 없어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trash was emptied or the item was already moved, so it can't be put back"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통을 비웠거나 이미 옮겨져 되돌릴 수 없어요"
          }
        }
      }
    },
    "휴지통을 열지 못했어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't Open Trash"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통을 열지 못했어요"
          }
        }
      }
    },
    "휴지통이에요. 비우면 되돌릴 수 없어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trash. Emptying it can't be undone"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통이에요. 비우면 되돌릴 수 없어요"
          }
        }
      }
    }
  },
  "version": "1.0"
}
