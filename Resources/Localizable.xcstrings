          }
        }
      }
    },
    "휴지통으로 옮길까요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move to Trash?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통으로 옮길까요?"
          }
        }
      }
    },
    "휴지통을 열지 못했어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't Open Trash"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통을 열지 못했어요"
          }
        }
      }
    },
    "휴지통이 비어 보이나요? 전체 디스크 접근을 켜야 안에 있는 파일을 확인할 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does Trash look empty? Turn on Full Disk Access to see the files inside."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통이 비어 보이나요? 전체 디스크 접근을 켜야 안에 있는 파일을 확인할 수 있어요."
          }
        }
      }
    }
  },
  "version": "1.0"
}
