    "첨부 사본이에요. 메일 원본은 다시 열 수 있어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies of attachments you opened. Originals stay in Mail, so you can open them again."
          }
