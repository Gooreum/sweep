        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번에는 정리할 파일이 없어요"
          }
        }
      }
    },
    "인터넷 없이 %@을 쓸 때 필요한 파일이에요. 지우면 다시 받아요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files needed to use %@ offline. They will download again if deleted"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인터넷 없이 %@을 쓸 때 필요한 파일이에요. 지우면 다시 받아요"
          }
        }
      }
    },
    "일부 복구": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Partly Restored"
          }
        },
