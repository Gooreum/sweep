            "state": "translated",
            "value": "다운로드 폴더부터 보여드려요"
          }
        }
      }
    },
    "닫기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫기"
          }
        }
      }
    },
    "대부분은 맨 위 폴더 안에 있어요. 우선 그곳부터 열어 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most files are inside the top folder. Open that folder first."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대부분은 맨 위 폴더 안에 있어요. 우선 그곳부터 열어 주세요."
          }
        }
      }
    },
    "더 찾으려면 접근을 허용해 주세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow access to find more files"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 찾으려면 접근을 허용해 주세요"
          }
        }
      }
    },
    "더 커지지 않는 임시 파일이에요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary files that are no longer growing"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 커지지 않는 임시 파일이에요"
          }
        }
      }
    },
    "돌려놓을 폴더가 더는 없어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original folder no longer exists"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "돌려놓을 폴더가 더는 없어요"
          }
        }
      }
    },
    "되돌릴 수 없음": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't be undone"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "되돌릴 수 없음"
          }
        }
      }
    },
    "되살릴 파일이 휴지통에 없어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file to restore is not in Trash"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "되살릴 파일이 휴지통에 없어요"
