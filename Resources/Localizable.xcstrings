      }
    },
    "휴지통으로 옮길 내 파일이에요. 비우면 복구할 수 없으니 내용을 먼저 확인해 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your files will move to Trash. Check their contents first: once Trash is emptied, they cannot be recovered."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통으로 옮길 내 파일이에요. 비우면 복구할 수 없으니 내용을 먼저 확인해 주세요."
          }
        }
      }
    },
    "휴지통으로 옮길까요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move to Trash?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통으로 옮길까요?"
          }
        }
      }
    },
    "휴지통은 홈 폴더 안에 있어요. 허용하면 휴지통에 버린 파일을 찾을 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trash is inside your Home folder. Allow access to find files you’ve moved to Trash."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통은 홈 폴더 안에 있어요. 허용하면 휴지통에 버린 파일을 찾을 수 있어요."
          }
        }
      }
    },
    "휴지통을 비우기 전에는 고른 파일을 모두 복구할 수 있어요. 이 중 %lld개는 다시 만들 수 없는 파일이에요. 휴지통까지 비우면 복구할 수 없어요. 저장 공간은 비운 뒤에 생겨요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can restore all selected files until you empty Trash. %lld of them cannot be recreated. Emptying Trash deletes them permanently and frees up storage space."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통을 비우기 전에는 고른 파일을 모두 복구할 수 있어요. 이 중 %lld개는 다시 만들 수 없는 파일이에요. 휴지통까지 비우면 복구할 수 없어요. 저장 공간은 비운 뒤에 생겨요."
          }
        }
      }
    },
    "휴지통을 비우기 전에는 파일을 다시 꺼낼 수 있어요. 휴지통까지 비우면 복구할 수 없어요. 저장 공간은 비운 뒤에 생겨요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can get your files back until you empty Trash. Emptying Trash deletes them permanently and frees up storage space."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통을 비우기 전에는 파일을 다시 꺼낼 수 있어요. 휴지통까지 비우면 복구할 수 없어요. 저장 공간은 비운 뒤에 생겨요."
          }
        }
      }
    },
    "휴지통을 비우면 %@의 저장 공간이 생겨요. 비운 파일은 복구할 수 없어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty Trash to free up %@ of storage. Files deleted this way cannot be restored"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통을 비우면 %@의 저장 공간이 생겨요. 비운 파일은 복구할 수 없어요"
          }
        }
      }
    },
    "휴지통을 열려면 허용이 필요해요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Access to Open Trash"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통을 열려면 허용이 필요해요"
          }
        }
      }
    },
    "휴지통을 열지 못했어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't Open Trash"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통을 열지 못했어요"
          }
        }
      }
    }
  },
  "version": "1.0"
}
