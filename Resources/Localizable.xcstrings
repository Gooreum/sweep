    "내 사용자 폴더": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My Home Folder"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 사용자 폴더"
          }
        }
      }
    },
    "내 사용자 폴더 밖에 있는 내 소유 항목이에요. 어떤 프로그램이 쓰는지 확인하고 지우세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items you own outside your home folder. Check which program uses them before deleting."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 사용자 폴더 밖에 있는 내 소유 항목이에요. 어떤 프로그램이 쓰는지 확인하고 지우세요."
          }
        }
      }
    },
    "내 사용자 폴더 안": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inside My Home Folder"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 사용자 폴더 안"
          }
        }
      }
    },
    "내 사용자 폴더 자체나 이를 포함하는 폴더는 추가할 수 없어요. 그 안에 보이는 폴더는 이미 모두 살펴봐요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can't add your home folder itself or a folder that contains it. All visible folders inside it are already checked."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 사용자 폴더 자체나 이를 포함하는 폴더는 추가할 수 없어요. 그 안에 보이는 폴더는 이미 모두 살펴봐요."
          }
        }
      }
    },
    "내 사용자 폴더, 디스크 전체, 응용 프로그램도 살펴볼 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can also check your home folder, entire disks, and Applications."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 사용자 폴더, 디스크 전체, 응용 프로그램도 살펴볼 수 있어요."
          }
        }
      }
    },
    "내 사용자 폴더와 추가한 폴더에서 큰 파일을 찾아요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find large files in your home folder and folders you've added."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 사용자 폴더와 추가한 폴더에서 큰 파일을 찾아요."
          }
        }
      }
    },
    "내 사용자 폴더의 기본 폴더나 계정 데이터라 지울 수 없어요: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't delete a standard home folder or account data: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 사용자 폴더의 기본 폴더나 계정 데이터라 지울 수 없어요: %@"
          }
        }
      }
    },
    "내 파일이에요. 휴지통으로 가지만 비우면 되돌릴 수 없어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your files. They'll go to Trash, but emptying it can't be undone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 파일이에요. 휴지통으로 가지만 비우면 되돌릴 수 없어요."
          }
        }
      }
    },
