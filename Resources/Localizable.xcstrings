            "value": "%1$@ %2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "%@ %@의 일부로 실행 중이에요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running as part of %1$@ %2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@의 일부로 실행 중이에요"
          }
        }
      }
    },
    "%@ %lld개": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %#@items@"
          },
          "substitutions": {
            "items": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg item"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg items"
                    }
                  }
                }
              }
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld개"
          }
        }
      }
    },
    "%@ 검색 중…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning %@…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 검색 중…"
          }
        }
      }
    },
    "%@ 만듦": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Created %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 만듦"
          }
        }
      }
    },
    "%@ 안에 표시할 항목이 없어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No items to show in %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 안에 표시할 항목이 없어요"
          }
        }
      }
    },
    "%@ 외 %lld개": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ and %lld more"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 외 %2$lld개"
          }
        }
      }
    },
    "%@ 외 %lld곳에서 큰 파일과 중복 파일을 찾아요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find large and duplicate files in %1$@ and %2$lld more locations"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 외 %2$lld곳에서 큰 파일과 중복 파일을 찾아요"
          }
        }
      }
    },
    "%@ 읽는 중…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading %@…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を読み込み中…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 읽는 중…"
          }
        }
      }
    },
    "%@ 읽었어요…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read %@…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を読み込みました…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 읽었어요…"
          }
        }
      }
    },
    "%@ 찾는 중": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — scanning"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 찾는 중"
          }
        }
      }
    },
    "%@ 폴더를 선택하고 허용을 눌러 주세요. 이 폴더를 여는 이유: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the %1$@ folder and click Allow. Why Sweep needs this folder: %2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 폴더를 선택하고 허용을 눌러 주세요. 이 폴더를 여는 이유: %@"
          }
        }
      }
    },
    "%@ 휴지통 파일이에요. 지우면 복구할 수 없어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files in Trash on %@. Deletion is permanent and cannot be undone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 휴지통 파일이에요. 지우면 복구할 수 없어요"
          }
        }
      }
    },
    "%@, 총 %lld개는 Mac 암호가 있어야 지울 수 있어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$lld items in total, require your Mac password to delete."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, 총 %lld개는 Mac 암호가 있어야 지울 수 있어요"
          }
        }
      }
    },
    "%@에서 큰 파일과 중복 파일을 찾아요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find large and duplicate files in %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 큰 파일과 중복 파일을 찾아요"
          }
        }
      }
    },
    "%@을 인터넷 없이 쓸 때 필요해요. 지우면 인터넷에 연결해 다시 받아야 해요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files for using %@ offline. After deletion, connect to the internet to download them again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을 인터넷 없이 쓸 때 필요해요. 지우면 인터넷에 연결해 다시 받아야 해요"
          }
        }
      }
    },
    "%@의 %@ 시험 기기예요. 지우면 안의 앱과 설정, 데이터도 사라져요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test device: %1$@ running %2$@. Deleting it removes its apps, settings, and data."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 %@ 시험 기기예요. 지우면 안의 앱과 설정, 데이터도 사라져요"
          }
        }
      }
    },
    "%@의 일부로 실행 중이에요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running as part of %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 일부로 실행 중이에요"
          }
        }
      }
    },
    "%@이 빠르게 열려고 모아 둔 파일이에요. 지워도 다시 생겨요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files %@ keeps so it opens faster. They come back if deleted"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이 빠르게 열려고 모아 둔 파일이에요. 지워도 다시 생겨요"
          }
        }
      }
    },
