        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통으로 이동할까요?"
          }
        }
      }
    },
    "휴지통을 비우기 전까지 복원할 수 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can restore items until you empty the Trash."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통을 비우기 전까지 복원할 수 있습니다."
          }
        }
      }
    },
    "휴지통을 비우기 전까지 복원할 수 있습니다. 휴지통을 비워야 공간이 확보됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can restore items until you empty the Trash. Space is freed only when you empty the Trash."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통을 비우기 전까지 복원할 수 있습니다. 휴지통을 비워야 공간이 확보됩니다."
          }
        }
      }
    },
    "휴지통을 비우면 %@가 실제로 확보됩니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty the Trash to actually free up %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통을 비우면 %@가 실제로 확보됩니다"
          }
        }
      }
    },
    "휴지통을 비워야 디스크 공간이 늘어납니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty the Trash to free up disk space"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통을 비워야 디스크 공간이 늘어납니다"
          }
        }
      }
    },
    "휴지통을 비웠거나 이미 옮겨져 되돌릴 수 없습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Trash was emptied or the item was already moved, so it can't be restored"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통을 비웠거나 이미 옮겨져 되돌릴 수 없습니다"
          }
        }
      }
    },
