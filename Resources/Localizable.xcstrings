            "value": "Partly Cleaned"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 정리"
          }
        }
      }
    },
    "임시 파일과 앱 사용 기록은 다시 생겨요. 내 파일과 앱 데이터는 내용을 보고 골라 주세요. 시스템과 계정 데이터는 보호해요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary files and app activity logs come back. Review your files and app data before choosing them. System and account data are protected."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "임시 파일과 앱 사용 기록은 다시 생겨요. 내 파일과 앱 데이터는 내용을 보고 골라 주세요. 시스템과 계정 데이터는 보호해요."
          }
        }
      }
    },
    "잠시 기다리면 많이 쓰는 프로그램부터 보여드려요.": {
