    "코드 검색이나 명령 실행 중에는 Mac도 일을 해요. Codex에서 작업을 끝내거나 중단하면 그 작업의 CPU 사용도 줄어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Code searches and commands also use your Mac’s CPU. Finishing or canceling the task in Codex reduces that work."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드 검색이나 명령 실행 중에는 Mac도 일을 해요. Codex에서 작업을 끝내거나 중단하면 그 작업의 CPU 사용도 줄어요."
          }
        }
      }
    },
    "코드를 읽고 고치거나 명령을 실행하는 일을 돕는 AI 개발 도구예요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An AI coding tool that helps read and edit code and run commands."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드를 읽고 고치거나 명령을 실행하는 일을 돕는 AI 개발 도구예요."
          }
        }
      }
    },
    "코어 하나를 모두 쓰면 막대가 꽉 차요. 더 많이 쓰는 프로그램은 옆의 숫자로 비교해 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A full bar means one core’s worth of CPU use. Compare the numbers to tell higher usage levels apart."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코어 하나를 모두 쓰면 막대가 꽉 차요. 더 많이 쓰는 프로그램은 옆의 숫자로 비교해 주세요."
          }
        }
      }
    },
    "크기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Size"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크기"
          }
        }
      }
    },
    "크기 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Size %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크기 %@"
          }
        }
      }
    },
    "크기 확인 중… %lld%%": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking size… %lld%%"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크기 확인 중… %lld%%"
          }
        }
      }
    },
    "큰 파일": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Large Files"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큰 파일"
          }
        }
      }
    },
    "큰 파일과 중복 파일 찾기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find Large Files and Duplicates"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큰 파일과 중복 파일 찾기"
          }
        }
      }
    },
    "큰 파일과 중복 파일, 버린 파일, 앱을 만들며 쌓인 파일을 찾아요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find large files, duplicates, discarded files, and files left from building apps"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큰 파일과 중복 파일, 버린 파일, 앱을 만들며 쌓인 파일을 찾아요"
          }
        }
      }
    },
    "큰 폴더부터 열어 보며 어디에 공간을 많이 쓰는지 확인하세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the largest folders first to see what uses the most space."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큰 폴더부터 열어 보며 어디에 공간을 많이 쓰는지 확인하세요."
          }
        }
      }
    },
    "키보드, 마우스, 트랙패드로 누르고 움직인 내용을 Mac에 전달해요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passes keystrokes, clicks, and trackpad movements to your Mac."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드, 마우스, 트랙패드로 누르고 움직인 내용을 Mac에 전달해요."
          }
        }
      }
    },
    "통화와 녹음, 음악 재생이 이어지는 동안 계속 일해요. 쓰지 않는 통화나 녹음을 끝내면 소리 처리도 줄어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It keeps working during calls, recording, and playback. End calls or recordings you no longer need to reduce audio work."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화와 녹음, 음악 재생이 이어지는 동안 계속 일해요. 쓰지 않는 통화나 녹음을 끝내면 소리 처리도 줄어요."
          }
        }
      }
    },
    "파일 %lld개가 휴지통에 있어요. 옮긴 용량은 %@예요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld files are in Trash. Total moved: %2$@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 %1$lld개가 휴지통에 있어요. 옮긴 용량은 %2$@예요."
          }
        }
      }
    },
    "파일 %lld개를 완전히 지웠어요. %@의 공간이 생겼고, 복구할 수 없어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deleted %1$lld files, freeing %2$@. They cannot be restored."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 %1$lld개를 완전히 지웠어요. %2$@의 공간이 생겼고, 복구할 수 없어요."
          }
        }
      }
    },
    "파일 관리": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File Management"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 관리"
          }
        }
      }
    },
    "파일 복사나 폴더 미리보기에 시간이 걸릴 수 있어요. 복사 진행창을 확인하고 작업이 끝날 때까지 기다려 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copying files and preparing folder previews can take time. Check any copy progress windows and let the work finish."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 복사나 폴더 미리보기에 시간이 걸릴 수 있어요. 복사 진행창을 확인하고 작업이 끝날 때까지 기다려 주세요."
          }
        }
      }
    },
    "파일 위치": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File Location"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 위치"
          }
        }
      }
    },
    "파일 이름과 내용을 읽어 두고 Spotlight 검색에서 빨리 찾게 해 줘요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads file names and contents so Spotlight can find them quickly."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 이름과 내용을 읽어 두고 Spotlight 검색에서 빨리 찾게 해 줘요."
          }
        }
      }
    },
    "파일과 폴더를 열고, 복사하거나 옮기는 Finder예요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder lets you open, copy, and move files and folders."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일과 폴더를 열고, 복사하거나 옮기는 Finder예요."
          }
        }
      }
    },
    "파일과 폴더의 크기를 확인하고 있어요…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking file and folder sizes…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일과 폴더의 크기를 확인하고 있어요…"
          }
        }
      }
    },
    "파일을 골라 주세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose files"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 골라 주세요"
          }
        }
      }
    },
    "파일을 많이 받거나 옮긴 뒤에는 목록과 바뀐 내용을 맞추는 데 시간이 걸려요. Finder에서 전송 상태를 확인해 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After large downloads or moves, updating file lists and changes takes time. Check the transfer status in Finder."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 많이 받거나 옮긴 뒤에는 목록과 바뀐 내용을 맞추는 데 시간이 걸려요. Finder에서 전송 상태를 확인해 보세요."
          }
        }
      }
    },
    "파일을 많이 추가하거나 macOS를 업데이트한 뒤에는 검색할 내용을 다시 읽어요. 이 준비가 끝나면 사용량이 줄어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After large file additions or a macOS update, it reads files to prepare search results. CPU use drops when that work finishes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 많이 추가하거나 macOS를 업데이트한 뒤에는 검색할 내용을 다시 읽어요. 이 준비가 끝나면 사용량이 줄어요."
          }
        }
      }
    },
    "파일을 원래 자리에 놓고 있어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restoring files to their original locations"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 원래 자리에 놓고 있어요"
          }
        }
      }
    },
    "파일을 원래 자리에 놓고 있어요…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restoring files to their original locations…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 원래 자리에 놓고 있어요…"
          }
        }
      }
    },
    "파일을 읽고 명령을 실행하는 등 요청한 일을 진행할 때 사용량이 늘어요. 멈추려면 Claude에서 진행 중인 요청을 중단해 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading files and running commands for your request can use CPU. To stop that work, cancel the active request in Claude."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 읽고 명령을 실행하는 등 요청한 일을 진행할 때 사용량이 늘어요. 멈추려면 Claude에서 진행 중인 요청을 중단해 주세요."
          }
        }
      }
    },
    "페이지 안의 영상과 코드가 계속 작동할 수 있어요. 최근 연 웹페이지를 닫아 사용량이 줄어드는지 확인해 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Videos and code on a page can keep running. Close recently opened pages and check whether CPU use drops."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지 안의 영상과 코드가 계속 작동할 수 있어요. 최근 연 웹페이지를 닫아 사용량이 줄어드는지 확인해 보세요."
          }
        }
      }
    },
    "폴더": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folders"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더"
          }
        }
      }
    },
    "폴더 선택 필요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a Folder"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더 선택 필요"
          }
        }
      }
    },
    "폴더 추가": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Folder"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더 추가"
          }
        }
      }
    },
    "폴더 추가…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Folder…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더 추가…"
          }
        }
      }
    },
    "폴더 허용은 macOS 시스템 설정에 나오지 않아요. 여기서 해제할 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder access does not appear in macOS System Settings. You can revoke it here."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더 허용은 macOS 시스템 설정에 나오지 않아요. 여기서 해제할 수 있어요."
          }
        }
      }
    },
    "폴더를 허용하면 여기서도 찾을 수 있어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow folder access to search here too"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더를 허용하면 여기서도 찾을 수 있어요"
          }
        }
      }
    },
    "폴더를 허용해야 내용을 확인할 수 있어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow folder access to view its contents"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더를 허용해야 내용을 확인할 수 있어요"
          }
        }
      }
    },
    "표에서 프로그램을 골라 보세요. 알려진 프로그램은 하는 일과 종료해도 되는지 설명해 드려요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a program in the table. For programs we recognize, you’ll see what they do and whether to quit them."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표에서 프로그램을 골라 보세요. 알려진 프로그램은 하는 일과 종료해도 되는지 설명해 드려요."
          }
        }
      }
    },
    "프로그램": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Programs"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로그램"
          }
        }
      }
    },
    "프로그램 %lld개": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld program"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld programs"
                }
              }
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로그램 %lld개"
          }
        }
      }
    },
    "프로그램 사용률순": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Programs by CPU Usage"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로그램 사용률순"
          }
        }
      }
    },
    "프로그램과 위치": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Program and Location"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로그램과 위치"
          }
        }
      }
    },
    "프로그램별 숫자는 코어 하나를 모두 쓰면 100%%예요. 여러 코어를 함께 쓰면 이 Mac에서는 최대 %lld%%까지 나와요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For each program, 100%% means full use of one core. Using several cores can bring the number up to %lld%% on this Mac."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로그램별 숫자는 코어 하나를 모두 쓰면 100%%예요. 여러 코어를 함께 쓰면 이 Mac에서는 최대 %lld%%까지 나와요."
          }
        }
      }
    },
    "프로그램이 CPU를 쓰기 시작하면 여기에 나타나요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Programs appear here once they start using the CPU."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로그램이 CPU를 쓰기 시작하면 여기에 나타나요."
          }
        }
      }
    },
    "프로젝트 설정 파일을 확인해 다시 만들 수 있는 폴더를 찾았어요. 최근에 수정한 프로젝트에는 확인 필요 표시를 붙였어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sweep checked the project settings files to find folders you can recreate. Recently changed projects are marked Needs review."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트 설정 파일을 확인해 다시 만들 수 있는 폴더를 찾았어요. 최근에 수정한 프로젝트에는 확인 필요 표시를 붙였어요."
          }
        }
      }
    },
    "프로젝트 설치·빌드 폴더": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Project Install & Build Folders"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트 설치·빌드 폴더"
          }
        }
      }
    },
    "프로젝트는 어디에 있나요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where are your projects?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트는 어디에 있나요?"
          }
        }
      }
    },
    "프로젝트를 모아 둔 폴더를 알려 주세요. package.json 같은 프로젝트 설정 파일이 있는 곳에서, 지워도 다시 만들어지는 폴더를 찾아요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell me where you keep your projects. Sweep looks next to project files like package.json for folders that get recreated if deleted."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트를 모아 둔 폴더를 알려 주세요. package.json 같은 프로젝트 설정 파일이 있는 곳에서, 지워도 다시 만들어지는 폴더를 찾아요."
          }
        }
      }
    },
    "프로젝트를 어디에 보관하나요? ~/Code처럼 프로젝트가 모인 폴더를 골라 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where do you keep your projects? Choose a folder that contains them, such as ~/Code."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트를 어디에 보관하나요? ~/Code처럼 프로젝트가 모인 폴더를 골라 주세요."
          }
        }
      }
    },
    "프로젝트에서 다시 만들 수 있는 파일 찾기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find project files you can recreate"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트에서 다시 만들 수 있는 파일 찾기"
          }
        }
      }
    },
    "프로젝트에서 다시 만들 수 있는 폴더(node_modules, .venv, Pods 등)를 찾아요. 휴지통으로 옮겨도 다시 설치하거나 빌드하면 생겨요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds folders in your projects that can be recreated (node_modules, .venv, Pods, and more). If you move them to Trash, reinstalling or building brings them back."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트에서 다시 만들 수 있는 폴더(node_modules, .venv, Pods 등)를 찾아요. 휴지통으로 옮겨도 다시 설치하거나 빌드하면 생겨요."
          }
        }
      }
    },
    "필요 없는 작업이면 종료해도 괜찮아요. 진행 중인 작업은 멈춰요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can quit it if you no longer need the task. Work in progress will stop."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요 없는 작업이면 종료해도 괜찮아요. 진행 중인 작업은 멈춰요."
          }
        }
      }
    },
    "필요 없는 파일을 찾아 종류별로 보여줘요. 결과를 보고 정리할 것을 고르면 돼요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find files you may no longer need, grouped by type. Review the results and choose what to clean."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요 없는 파일을 찾아 종류별로 보여줘요. 결과를 보고 정리할 것을 고르면 돼요."
          }
        }
      }
    },
    "필요 없는 파일인지 확인했나요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have you checked that you no longer need these files?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요 없는 파일인지 확인했나요?"
          }
        }
      }
    },
    "필요한 권한이 켜져 있어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All required permissions are on"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요한 권한이 켜져 있어요"
          }
        }
      }
    },
    "필요한 폴더와 달라요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A different folder is needed"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요한 폴더와 달라요"
          }
        }
      }
    },
    "한때 크게 늘었다가 지금은 멈춘 파일이에요. 쓰는 앱이 없으면 지워도 돼요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It grew fast but has stopped growing. Safe to delete if no app uses it"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한때 크게 늘었다가 지금은 멈춘 파일이에요. 쓰는 앱이 없으면 지워도 돼요"
          }
        }
      }
    },
    "한번에 찾기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search All"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한번에 찾기"
          }
        }
      }
    },
    "항목": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목"
          }
        }
      }
    },
    "항목 %lld개": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld item"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld items"
                }
              }
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목 %lld개"
          }
        }
      }
    },
    "항목에 마우스를 올리면 지워도 되는 이유나 주의할 점을 볼 수 있어요. 시스템과 계정에 필요한 파일은 보호해요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point to an item to see why it is deletable or what to check first. Files needed by macOS and your account are protected."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목에 마우스를 올리면 지워도 되는 이유나 주의할 점을 볼 수 있어요. 시스템과 계정에 필요한 파일은 보호해요."
          }
        }
      }
    },
    "해제": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해제"
          }
        }
      }
    },
    "허용": {
