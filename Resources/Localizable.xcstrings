            "state": "translated",
            "value": "다시 읽기"
          }
        }
      }
    },
    "다운로드 폴더부터 보여드려요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with Downloads"
          }
        },
        "ko": {
