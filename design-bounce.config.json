{
  "adapter": "macos-swiftui",
  "scheme": "sweep",
  "bundleId": "com.gooreum.sweep",
  "tokens": "Sources/SweepApp/Theme.swift",
  "captureDir": ".design-bounce/shots",
  "screens": {
    "idle":        { "deeplink": "--stage idle",        "route": "Sources/SweepApp/FeatureScreen.swift", "settleMs": 1500 },
    "scanning":    { "deeplink": "--stage scanning",    "route": "Sources/SweepApp/FeatureScreen.swift", "settleMs": 1500 },
    "results":     { "deeplink": "--stage results",     "route": "Sources/SweepApp/FeatureScreen.swift", "settleMs": 1500 },
    "cleaned":     { "deeplink": "--stage cleaned",     "route": "Sources/SweepApp/FeatureScreen.swift", "settleMs": 1500 },
    "danger-only": { "deeplink": "--stage danger-only", "route": "Sources/SweepApp/FeatureScreen.swift", "settleMs": 1500 },
    "smart-summary": { "deeplink": "--stage smart-summary", "route": "Sources/SweepApp/SmartScanView.swift", "settleMs": 1500 },
    "main":        { "deeplink": "",                    "route": "Sources/SweepApp/ContentView.swift",   "settleMs": 2000 }
  }
}
