# App Store 앱 정보·스크린샷 업로드.
#
# 빌드 업로드는 여기서 하지 않는다 — `scripts/upload-archive.sh`가 한다.
# 이 레인은 `fastlane/metadata`·`fastlane/screenshots`를 App Store Connect에 맞춘다.
# 심사 제출은 사람이 한다.
#
# 키는 업로드 스크립트와 같은 환경변수로 받는다: ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH(.p8)
#
#   fastlane mac metadata                    앱 정보만
#   fastlane mac metadata screenshots:true   스크린샷까지 교체
#   fastlane mac metadata version:1.0.4      그 버전에 반영 (없으면 App Store Connect에 새로 만든다)
#   fastlane mac pull_metadata               App Store Connect 값을 fastlane/metadata로 내려받기
default_platform(:mac)

platform :mac do
  # App Store Connect의 버전과 심사 상태를 읽어 로그에 남긴다. **아무것도 바꾸지 않는다.**
  # 이전 버전이 심사에 제출돼 있으면 `metadata`가 스크린샷을 못 지운다 — 올리기 전에 이걸로 본다.
  lane :status do
    api_key
    versions.each { |version, state| UI.message("#{version}  #{state}") }
  end

  # 이전 버전이 심사에 제출돼 있으면 deliver가 올바로 일하지 못한다.
  #
  # deliver는 심사 대기(`WAITING_FOR_REVIEW`) 버전을 "수정할 버전"으로 잡는다. 그러면 제출된 버전의
  # 이름을 새 버전으로 **바꿔 버리고**(1.0.3이 1.0.4가 됐다), 스크린샷은 제출 뒤라 API로 못 지운다
  # ("Can't Delete Screenshot After Submit for review"). 사람이 웹에서 심사를 철회하고 지워야만 통과했다.
  #
  # 그래서 deliver를 부르기 전에 상태를 본다. 철회는 심사 순서를 잃는 일이라 `cancel_review:true`를
  # 명시했을 때만 한다. 심사가 이미 진행 중(`IN_REVIEW`)이면 철회할 수 없다.
  private_lane :release_guard do |options|
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    UI.user_error!("App Store Connect에서 앱을 찾지 못했다") unless app

    submitted = lambda do
      app.get_app_store_versions(
        filter: { platform: "MAC_OS", appVersionState: "WAITING_FOR_REVIEW,IN_REVIEW" }, limit: 10)
    end
    pending = submitted.call
    next if pending.empty?

    names = pending.map { |v| "#{v.version_string} (#{v.app_version_state})" }.join(", ")
    if pending.any? { |v| v.app_version_state == "IN_REVIEW" }
      UI.user_error!("#{names} — 심사가 진행 중이라 철회할 수 없어요. 심사가 끝난 뒤 다시 실행하세요.")
    end
    unless options[:cancel_review].to_s == "true"
      UI.user_error!("#{names} — 심사에 제출돼 있어서 앱 정보·스크린샷을 올릴 수 없어요. " \
                     "제출을 철회하고 올리려면 cancel_review=true로 다시 실행하세요(심사 순서를 잃어요).")
    end

    app.get_review_submissions(filter: { platform: "MAC_OS", state: "WAITING_FOR_REVIEW" }).each do |submission|
      UI.important("심사 제출을 철회한다: #{names}")
      submission.cancel_submission
    end
    # 철회가 반영될 때까지 기다린다. 반영 전에 deliver가 돌면 같은 오류가 난다.
    24.times do
      break if submitted.call.empty?
      sleep(5)
    end
    UI.user_error!("심사 철회가 2분 안에 반영되지 않았어요. App Store Connect에서 상태를 확인하세요.") unless submitted.call.empty?
  end

  # [버전 문자열, 상태] 목록. 최근 것부터.
  private_lane :versions do
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    UI.user_error!("App Store Connect에서 앱을 찾지 못했다") unless app
    app.get_app_store_versions(filter: { platform: "MAC_OS" }, limit: 10)
       .sort_by { |v| v.created_date.to_s }.reverse
       .map { |v| [v.version_string, v.app_version_state] }
  end

  lane :metadata do |options|
    api_key
    release_guard(options)
    deliver(
      platform: "osx",
      app_version: options[:version],
      skip_binary_upload: true,
      skip_screenshots: options[:screenshots].to_s != "true",
      overwrite_screenshots: true,
      submit_for_review: false,
      # CI라 HTML 미리보기 확인을 띄울 사람이 없다
      force: true,
      run_precheck_before_submit: false
    )
  end

  # `fastlane deliver download_metadata`는 API 키를 JSON 본문으로만 받는다.
  # 키 파일을 복사하지 않으려고 같은 일을 레인 안에서 한다.
  lane :pull_metadata do
    api_key
    require "deliver"
    require "deliver/setup"
    options = FastlaneCore::Configuration.create(Deliver::Options.available_options, {
      platform: "osx", force: true, api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]
    })
    Deliver::Runner.new(options)
    app = Deliver.cache[:app]
    version = app.get_latest_app_store_version(platform: Spaceship::ConnectAPI::Platform::MAC_OS)
    Deliver::Setup.new.generate_metadata_files(app, version, File.expand_path("metadata", __dir__), options)
  end

  private_lane :api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )
  end
end
