<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 한국어도 영어도 아닌 사용자에게는 영어를 보여준다. 개발 지역이
	     ko면 일본어·독일어 사용자에게 한국어 화면이 뜬다. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ko</string>
	</array>
	<key>CFBundleName</key>
	<string>Sweep</string>
	<key>CFBundleDisplayName</key>
	<string>Sweep</string>
	<key>CFBundleIdentifier</key>
	<string>com.gooreum.sweep</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.5</string>
	<key>CFBundleVersion</key>
	<string>11</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHumanReadableCopyright</key>
	<string>MINGU</string>

	<!-- 번들 안에서 실행 파일 이름은 Sweep이다. SweepApp 그대로 두면
	     Dock과 강제 종료 목록에 그 이름이 나온다. -->
	<key>CFBundleExecutable</key>
	<string>Sweep</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>NSHighResolutionCapable</key>
	<true/>

	<!-- 없으면 App Store Connect가 업로드마다 수출 규정 질문을 띄운다.
	     Sweep은 암호화를 쓰지 않으므로 미리 못박는다. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- 디스크 맵이 홈 전체를 훑는다. 이 문자열이 없으면 macOS가
	     권한 대화를 띄우지 않고 조용히 빈 결과를 준다.
	     여기는 기본값(영어)이다. 한국어는 Resources/ko.lproj/InfoPlist.strings. -->
	<key>NSDesktopFolderUsageDescription</key>
	<string>See which files on your Desktop take up the most space.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>See which files in Documents take up the most space.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Find files in Downloads to review for cleanup and see how much space they use.</string>
</dict>
</plist>
